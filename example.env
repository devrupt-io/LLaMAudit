# Database
DATABASE_NAME=llamaudit
DATABASE_USER=llamaudit
DATABASE_PASSWORD=llamaudit_secret
DATABASE_HOST=db
DATABASE_PORT=5432

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Default chat models (comma-separated list of OpenRouter model IDs)
OPENROUTER_CHAT_MODELS=qwen/qwen3-8b,meta-llama/llama-3.1-8b-instruct

# Ollama configuration (optional, for local model inference)
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODELS=

# Service URLs
FRONTEND_URL=http://localhost:52000
CORS_ORIGINS=http://localhost:52000
